---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
interface Props {
  title?: string; banner?: string; description?: string; lang?: string;
  setOGTypeArticle?: boolean; headings?: MarkdownHeading[];
}
const { title, banner, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
---
<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
  <slot slot="head" name="head" />
  <div id="top-row" class="studio-shell"><div id="navbar-wrapper"><Navbar /></div></div>
  <main id="swup-container" class="studio-shell transition-swup-fade">
    <slot name="masthead" />
    <div id="main-grid" class="studio-grid">
      <div id="content-wrapper"><slot /></div>
      <SideBar headings={headings} />
    </div>
    <Footer />
  </main>
  <BackToTop />
</Layout>
