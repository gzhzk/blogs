---
import { profileConfig } from "../../config";
import { columns } from "../../data/columns";
import { getSortedPosts } from "../../utils/content-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
const posts = await getSortedPosts();
---
<section class="notes-profile notes-side-card" aria-labelledby="author-name">
  <div class="notes-profile-sky" />
  <a class="notes-avatar" href="https://gzhzk.github.io/" aria-label="前往 Zekai 的个人主页"><ImageWrapper src={profileConfig.avatar || ""} alt="Zekai 使用的头像" /></a>
  <span class="notes-profile-label">THE PERSON BEHIND THE NOTES</span>
  <h2 id="author-name">{profileConfig.name}</h2>
  <p class="notes-profile-subtitle">SCUT ’28 / 算法学习者</p>
  <p class="notes-profile-intro">关注 Agent、多模态视频算法模块与模型后训练。<br />在具体问题里，慢慢理解系统。</p>
  <div class="notes-profile-stats"><span><b>{posts.length}</b>篇笔记</span><span><b>{columns.length}</b>个学习栏目</span></div>
  <a class="notes-profile-link" href="https://gzhzk.github.io/">认识一下我 <span aria-hidden="true">↗</span></a>
  {profileConfig.links.map(link => <a class="notes-profile-social" href={link.url} rel="me noopener" target="_blank">{link.name} ↗</a>)}
</section>
