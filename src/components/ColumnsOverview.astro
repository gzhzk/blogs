---
import { columns } from "../data/columns";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";
const posts = await getSortedPosts();
const subtitles = ["跟上新想法", "把基础弄明白", "沿着源码看系统"];
const summaries = ["每周读一个模型，理解能力与边界。", "从直觉到公式，再到动手实现。", "追一次请求，理解模块与取舍。"];
const keywords = ["论文 · 复现 · 样例", "Transformer · BM25 · SVM", "架构 · 业务 · 数据流"];
---
<section id="columns" class="notes-columns" aria-label="三个学习栏目">
  {columns.map((column, index) => {
    const count = posts.filter(post => post.data.category === column.title).length;
    return <a class={`notes-column column-${column.slug}`} href={url(`/columns/${column.slug}/`)}>
      <div class="notes-column-label"><span>{column.number} / {column.title}</span><span aria-hidden="true">↗</span></div>
      <h2>{subtitles[index]}</h2><p>{summaries[index]}</p>
      <div class="notes-column-bottom"><span>{keywords[index]}</span><small>{count ? `${count} 篇` : "待开篇"}</small></div>
      <span class={`notes-column-art art-${index}`} aria-hidden="true" />
    </a>;
  })}
</section>
